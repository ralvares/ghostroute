    "oc 'create' 'secret' 'generic' 'token' '--from-literal=password=training' '--dry-run=client' '-o' 'json'",
    "oc 'create' 'secret' 'generic' 'token' '--from-literal=password=training' '--dry-run=server' '-o' 'json'",
    "oc 'patch' 'configmap' 'settings' '--type=merge' '-p' '{\"data\":{\"remove\":null,\"keep\":\"changed\"}}'",
    "oc 'patch' 'configmap' 'settings' '--type=merge' '-p' '{\"data\":{\"remove\":null}}' '-o' 'json'",
    "oc 'patch' 'configmap' 'settings' '--type=json' '-p' '[{\"op\":\"remove\",\"path\":\"/data/remove\"}]' '-o' 'json'",
