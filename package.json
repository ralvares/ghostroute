{
  "name": "roadshow-ghost-route",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:tools": "sh tools/build-template.sh",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsc --outDir .test-build --noEmit false && node --test tests/*.test.mjs",
    "test:browser": "python3 tests/gameplay.py http://127.0.0.1:4174/ artifacts/migrated",
    "test:semantics": "python3 tests/semantics.py http://127.0.0.1:4174/",
    "test:cluster": "python3 tests/cluster_browser.py http://127.0.0.1:4174/",
    "test:offline": "python3 tests/offline_browser.py http://127.0.0.1:4174/",
    "test:rpg": "python3 tests/rpg_browser.py http://127.0.0.1:4174/",
    "test:visual:legacy": "python3 tests/compare_screenshots.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.2.8",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "yaml": "2.9.1"
  }
}
